PORT=3000
# Optional: Set a password to protect the app. Leave empty for public access.
APP_PASSWORD =changu123
# Max file size in bytes (e.g., 2147483648 for 2GB)
MAX_FILE_SIZE=2147483648
# Total storage cap in bytes (e.g., 10737418240 for 10GB)
STORAGE_CAP=10737418240
# Hours to keep items before deleting (e.g., 24). Leave empty or 0 for never expire.
AUTO_EXPIRE_HOURS=0
# Comma-separated list of blocked extensions
BLOCKED_EXTENSIONS=.exe,.bat,.sh,.cmd
# Random string for cookie signing
COOKIE_SECRET=change_this_to_a_random_string
